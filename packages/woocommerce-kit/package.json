{
	"name": "@kizlo/woocommerce-kit",
	"version": "0.11.1",
	"type": "module",
	"description": "Headless WooCommerce storefront components for Kizlo, with framework-agnostic bones.",
	"keywords": [
		"wordpress",
		"woocommerce",
		"headless",
		"react",
		"ecommerce",
		"kizlo"
	],
	"license": "Apache-2.0",
	"author": "Kizlo",
	"sideEffects": false,
	"homepage": "https://github.com/kizlo-io/kit/tree/main/packages/woocommerce-kit#readme",
	"bugs": "https://github.com/kizlo-io/kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kizlo-io/kit.git",
		"directory": "packages/woocommerce-kit"
	},
	"engines": {
		"node": ">=22.14.0"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react/client.d.ts",
				"default": "./dist/react/client.js"
			}
		},
		"./react/cart": {
			"import": {
				"types": "./dist/react/cart.d.ts",
				"default": "./dist/react/cart.js"
			}
		},
		"./react/checkout": {
			"import": {
				"types": "./dist/react/checkout.d.ts",
				"default": "./dist/react/checkout.js"
			}
		},
		"./react/provider": {
			"import": {
				"types": "./dist/react/provider.d.ts",
				"default": "./dist/react/provider.js"
			}
		},
		"./react/search": {
			"import": {
				"types": "./dist/react/search.d.ts",
				"default": "./dist/react/search.js"
			}
		},
		"./react/server": {
			"import": {
				"types": "./dist/react/server.d.ts",
				"default": "./dist/react/server.js"
			}
		},
		"./react/storefront": {
			"import": {
				"types": "./dist/react/storefront.d.ts",
				"default": "./dist/react/storefront.js"
			}
		},
		"./react/checkout-fields": {
			"import": {
				"types": "./dist/react/checkout-fields.d.ts",
				"default": "./dist/react/checkout-fields.js"
			}
		},
		"./react/checkout-fields/tanstack-form": {
			"import": {
				"types": "./dist/react/checkout-fields/tanstack-form.d.ts",
				"default": "./dist/react/checkout-fields/tanstack-form.js"
			}
		},
		"./react/checkout-fields/react-hook-form": {
			"import": {
				"types": "./dist/react/checkout-fields/react-hook-form.d.ts",
				"default": "./dist/react/checkout-fields/react-hook-form.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown -w",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"clean": "git clean -xdf .cache .turbo dist node_modules"
	},
	"dependencies": {
		"@cfworker/json-schema": "^4.1.1",
		"@kizlo/kit": "workspace:*",
		"ajv": "^8.20.0",
		"ajv-errors": "^3.0.0",
		"ajv-formats": "^3.0.1",
		"nanostores": "^1.5.5",
		"postcode-validator": "3.10.22",
		"use-debounce": "catalog:"
	},
	"devDependencies": {
		"@hookform/resolvers": "catalog:",
		"@kizlo/woocommerce": "catalog:",
		"@standard-schema/spec": "^1.1.0",
		"@tanstack/react-form": "catalog:",
		"@tanstack/react-query": "catalog:",
		"@testing-library/react": "catalog:",
		"@tooling/typescript": "workspace:*",
		"@types/node": "catalog:",
		"@types/react": "catalog:react19",
		"@types/react-dom": "catalog:react19",
		"happy-dom": "catalog:",
		"kizlo": "catalog:",
		"nuqs": "catalog:",
		"react": "catalog:react19",
		"react-dom": "catalog:react19",
		"react-hook-form": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": ">=5.102.0",
		"kizlo": "^0.26.1",
		"nuqs": ">=2.10.0",
		"react": ">=19.0.0",
		"react-hook-form": "^7.89.0"
	},
	"peerDependenciesMeta": {
		"@hookform/resolvers": {
			"optional": true
		},
		"@tanstack/react-form": {
			"optional": true
		},
		"@tanstack/react-query": {
			"optional": true
		},
		"nuqs": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-hook-form": {
			"optional": true
		}
	}
}
